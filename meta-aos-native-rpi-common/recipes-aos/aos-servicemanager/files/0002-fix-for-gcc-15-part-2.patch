index 2fddae81..3c342535 100644
--- a/src/sm/launcher/runtimes/boot/efibootcontroller.cpp
+++ b/src/sm/launcher/runtimes/boot/efibootcontroller.cpp
@@ -60,11 +60,13 @@ RetWithError<size_t> EFIBootController::GetCurrentBoot() const
 {
     std::lock_guard lock {mMutex};
 
-    auto [efiCurrentBoot, err] = GetBootCurrent();
+    auto [bootVal, err] = GetBootCurrent();
     if (!err.IsNone()) {
         return {0, AOS_ERROR_WRAP(err)};
     }
 
+    size_t efiCurrentBoot = bootVal;
+
     LOG_DBG() << "Get EFI current boot" << Log::Field("bootID", efiCurrentBoot);
 
     auto itBootItem = std::find_if(mBootItems.begin(), mBootItems.end(),
