From c10a8116a634203a5f164ba3be62cc0c210523a6 Mon Sep 17 00:00:00 2001
From: Svitlana Drozd <svitlana_drozd@epam.com>
Date: Wed, 11 Nov 2026 20:13:58 +0200
Subject: [PATCH] sm: launcher: avoid capturing structured bindings

Capturing structured bindings directly in lambdas is a C++20 extension
and fails under strict GCC 15 diagnostic flags with -Werror.

Copy the structured binding into standard local variables prior to
lambda capture to ensure clean C++17 compilation compatibility.

Upstream-Status: Pending
Signed-off-by: Svitlana Drozd <svitlana_drozd@epam.com>
---
 core/aos_core_lib_cpp/src/core/sm/launcher/launcher.cpp | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/core/aos_core_lib_cpp/src/core/sm/launcher/launcher.cpp b/core/aos_core_lib_cpp/src/core/sm/launcher/launcher.cpp
index 8af080aa..77cda591 100644
--- a/core/aos_core_lib_cpp/src/core/sm/launcher/launcher.cpp
+++ b/core/aos_core_lib_cpp/src/core/sm/launcher/launcher.cpp
@@ -661,7 +661,10 @@ void Launcher::LoadInstancesData(const Array<InstanceInfo>& storedInstances)
     }

     for (const auto& instanceInfo : storedInstances) {
-        auto [instanceData, err] = AddInstanceData(instanceInfo);
+        auto [rawInstanceData, resErr] = AddInstanceData(instanceInfo);
+        auto instanceData = rawInstanceData;
+        auto err = resErr;
+
         if (!err.IsNone()) {
             LOG_ERR() << "Failed to add instance data" << Log::Field("instance", instanceInfo)
                       << Log::Field(AOS_ERROR_WRAP(err));
@@ -674,9 +677,9 @@ void Launcher::LoadInstancesData(const Array<InstanceInfo>& storedInstances)
         }

         if (err = mLaunchPool.AddTask([this, instanceData](void*) {
-                if (auto err = LoadInstanceData(*instanceData); !err.IsNone()) {
+                if (auto loadErr = LoadInstanceData(*instanceData); !loadErr.IsNone()) {
                     LOG_ERR() << "Failed to load instance data" << Log::Field("instance", instanceData->mInfo)
-                              << Log::Field(AOS_ERROR_WRAP(err));
+                              << Log::Field(AOS_ERROR_WRAP(loadErr));
                 }
             });
             !err.IsNone()) {
--
2.43.0

